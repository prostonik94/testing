      "parameters": {
        "promptType": "define",
        "text": "=You are a social media content writer.\n\nBased on this news title: \"{{ $json.title }}\"\n\nWrite a short announcement of 150-200 characters in TWO languages.\n\nReturn ONLY this JSON format:\n{\n  \"text_en\": \"your english text here\",\n  \"text_ar\": \"your arabic text here\"\n}\n\nNo explanations, no markdown, only JSON.\nRespond ONLY with valid JSON, no markdown, no extra text:\n{\"text_en\": \"...\", \"text_ar\": \"...\"}",
        "batching": {
          "batchSize": 1,
          "delayBetweenBatches": 1000
        }
